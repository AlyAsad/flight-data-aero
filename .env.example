SERPAPI_API_KEY=
PROVIDER_MODE=fast_flights
CACHE_TTL_DAYS=1
SERPAPI_MONTHLY_CAP=230
SERPAPI_BATCH_MAX_AIRPORTS=7
FETCH_CONCURRENCY=3
FETCH_DELAY_SECONDS=0.5-1
GOOGLE_CONSENT_COOKIE=true
# set on public deployments: required to change settings or clear the cache.
ADMIN_PASSWORD=

# Database for deployments without a disk (e.g. Vercel): Turso. Leave empty to use data/flights.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
