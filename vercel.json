{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "lhr1"
  ],
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,backend/tests/**,data/**}"
    }
  }
}
